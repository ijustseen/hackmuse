# Copy to .env.local and fill in.

# Gemma 4 — Google AI Studio key (https://aistudio.google.com/apikey).
# GEMINI_API_KEY is also accepted (same kind of key). Without a key the app runs in demo mode.
GEMMA_API_KEY=
# gemma-4-26b-a4b-it (default, fast) or gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it
# minimal = first token in ~1s; remove for default thinking (~25s)
GEMMA_THINKING=minimal

# ElevenLabs — without a key the debate plays as captions only.
ELEVENLABS_API_KEY=
# eleven_multilingual_v2 (default) | eleven_flash_v2_5 (faster) | eleven_v3 (delivery tags)
ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional per-judge voice overrides (voice IDs from your ElevenLabs library)
# ELEVENLABS_VOICE_CHAIR=
# ELEVENLABS_VOICE_SHARK=
# ELEVENLABS_VOICE_BUILDER=
# ELEVENLABS_VOICE_VISIONARY=
