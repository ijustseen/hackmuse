# Copy to .env.local and fill in.

# Gemma 4 — Google AI Studio key (https://aistudio.google.com/apikey).
# Used by the debate (/api/debate), the feed (/api/feed) and the research-backed review (/api/gemma-review).
# GEMMA_API_KEY and GEMINI_API_KEY are the same kind of key; either name works.
# Without a key the debate runs in demo mode and the review shows as unavailable.
GEMMA_API_KEY=
# gemma-4-26b-a4b-it (default, fast) or gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it
# minimal = first token in ~1s; remove for default thinking (~25s)
GEMMA_THINKING=minimal

# Public URL of the deployed site, e.g. https://hackmuse.example. Share images and link previews
# need absolute URLs; without it they point at http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Supabase: saved verdicts, share links, waitlist (optional) ---
# Without these the app still runs on sessionStorage; sharing and the waitlist are then off.
# HACKMUSE_SUPABASE_URL is the project URL. The secret key stays on the server only and bypasses
# row-level security, so never expose it to the browser or commit it.
# The HACKMUSE_ prefix is deliberate: a machine-wide SUPABASE_URL from another project would
# otherwise override .env.local and send this app to the wrong database.
HACKMUSE_SUPABASE_URL=
HACKMUSE_SUPABASE_ANON_KEY=
HACKMUSE_SUPABASE_SERVICE_ROLE_KEY=

# --- Abuse limits for the routes that spend money (all optional) ---
# Counts live in process memory, so they reset on restart and assume one instance.
# Per client per hour.
# LIMIT_DEBATE_PER_VISITOR=8
# LIMIT_FEED_PER_VISITOR=8
# LIMIT_REVIEW_PER_VISITOR=6
# Site-wide requests per UTC day, the hard cap. Set to your plan.
# LIMIT_DEBATE_DAILY=300
# LIMIT_FEED_DAILY=300
# LIMIT_REVIEW_DAILY=200
# Database writes (new ideas, shares) and waitlist signups, same shape.
# LIMIT_WRITES_PER_VISITOR=30
# LIMIT_WRITES_DAILY=3000
# LIMIT_WAITLIST_PER_VISITOR=5
# LIMIT_WAITLIST_DAILY=500
# How many proxies sit in front of the app (Render, DigitalOcean, a CDN). The client is the
# Nth entry from the right of X-Forwarded-For.
# TRUSTED_PROXY_HOPS=1

# --- /api/evaluations pipeline (podcast + research + analysis) ---
# stub (default) or live. Each provider switches on its own.
LLM_PROVIDER=stub
SEARCH_PROVIDER=stub
SPEECH_PROVIDER=stub
PAGE_PROVIDER=stub

# Used when LLM_PROVIDER=live. The call itself is added in server/providers/live/llm.ts.
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Used when SPEECH_PROVIDER=live. The call itself is added in server/providers/live/speech.ts.
# ELEVENLABS_VOICE_HOST=
# ELEVENLABS_VOICE_CRITIC=

# Pause between stub steps, in milliseconds. 0 disables it.
STUB_LATENCY_MS=150

# --- Past-projects corpus (optional) ---
# `node scripts/ingest-github.mjs` writes data/github-corpus.json (uses GITHUB_TOKEN or a logged-in `gh`).
# `node scripts/embed-corpus.mjs` writes the vectors the review searches (uses the Gemma/Gemini key above).
# Without these files the review falls back to Google Search only.
